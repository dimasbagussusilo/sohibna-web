# Sohibna web — LANDING mode (apex origin, e.g. sohibna.com). Rendered to
# /etc/nginx/conf.d/default.conf at container start by docker-entrypoint.d/
# 05-select-nginx-mode.sh (APP_MODE=landing).
#
# Same image as app mode — only this server block differs:
#   • /, /en, /ar serve the SPA shell (the landing routes in src/App.tsx)
#   • hashed assets, fonts, icons, og-image, robots.txt are served
#   • sw.js / registerSW.js / manifest.webmanifest 404 → the landing origin
#     never owns a service worker and is never installable (the SPA also
#     self-gates via src/pwa.ts — belt and braces)
#   • EVERYTHING ELSE 301s to the app origin (${APP_ORIGIN}) — the midwifery
#     apex pattern, so deep links land in the app and no app surface is
#     usable on the apex origin.
#
# envsubst substitutes ONLY defined env vars, so $uri/$request_uri survive.

server {
    listen 8080;
    server_name _;
    server_tokens off;

    root /usr/share/nginx/html;
    index index.html;

    types {
        text/html                html htm;
        text/css                 css;
        application/javascript   js mjs;
        application/manifest+json webmanifest;
        application/json         json;
        image/png                png;
        image/svg+xml            svg;
        image/x-icon             ico;
        image/webp               webp;
        font/woff2               woff2;
        font/ttf                 ttf;
        text/plain               txt;
    }
    default_type application/octet-stream;

    gzip on;
    gzip_types text/plain text/css application/json application/javascript
               application/manifest+json image/svg+xml;
    gzip_min_length 1024;

    # Strict landing CSP: no API, no third-party anything (all fonts are
    # self-hosted; the landing makes zero API calls).
    add_header Content-Security-Policy "default-src 'self'; connect-src 'self'; font-src 'self' data:; img-src 'self' data:; script-src 'self'; style-src 'self' 'unsafe-inline'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;

    # Default: negotiated freshness (no-cache semantics without add_header).
    expires -1;

    # The three landing entry points (with or without trailing slash).
    # Regex beats the catch-all `location /` below.
    location ~ ^/(en|ar)?/?$ {
        try_files /index.html =404;
    }
    location = /index.html {
        expires off;
        add_header Cache-Control "no-cache" always;
        add_header Content-Security-Policy "default-src 'self'; connect-src 'self'; font-src 'self' data:; img-src 'self' data:; script-src 'self'; style-src 'self' 'unsafe-inline'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header Referrer-Policy "strict-origin-when-cross-origin" always;
        add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    }

    # Immutable hashed assets + self-hosted fonts/icons.
    location /assets/ {
        expires off;
        add_header Cache-Control "public, max-age=31536000, immutable" always;
        add_header Content-Security-Policy "default-src 'self'; connect-src 'self'; font-src 'self' data:; img-src 'self' data:; script-src 'self'; style-src 'self' 'unsafe-inline'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header Referrer-Policy "strict-origin-when-cross-origin" always;
        add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    }
    location /fonts/ {
        expires off;
        add_header Cache-Control "public, max-age=31536000, immutable" always;
        add_header X-Content-Type-Options "nosniff" always;
    }
    location /icons/ {
        expires off;
        add_header Cache-Control "public, max-age=31536000, immutable" always;
        add_header X-Content-Type-Options "nosniff" always;
    }
    location = /og-image.png {
        expires off;
        add_header Cache-Control "public, max-age=86400" always;
        add_header X-Content-Type-Options "nosniff" always;
    }
    location = /robots.txt {
    }

    # Never installable from the landing origin.
    location = /sw.js {
        return 404;
    }
    location = /registerSW.js {
        return 404;
    }
    location = /manifest.webmanifest {
        return 404;
    }

    # Everything else lives on the app origin (midwifery apex pattern).
    location / {
        return 301 ${APP_ORIGIN}$request_uri;
    }
}
