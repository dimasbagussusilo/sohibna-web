# Local dev — backend running on this machine (sohibna-api `make run`, :8080).
VITE_API_BASE_URL=http://localhost:8080

# Google Sign-In (Firebase "Web SDK" client id — same value as the RN app's
# EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID).
VITE_GOOGLE_WEB_CLIENT_ID=819419693044-tjnl29n7pkft9kr25lg1q99vjdqqbruk.apps.googleusercontent.com

# Firebase Web app config (register a Web app in the Firebase "sohibna" project
# → Project settings → Your apps → Web app → config). Empty → Google button hidden.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
